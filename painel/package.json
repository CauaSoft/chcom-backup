{
  "name": "painel-backup-chcom",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de monitoramento de backups da CH.Com. Recebe os relatorios do Duplicati e mostra o tamanho de cada versao de backup.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "migrar": "tsx src/db/migrar.ts",
    "criar-cliente": "tsx src/scripts/criar-cliente.ts",
    "listar-clientes": "tsx src/scripts/listar-clientes.ts",
    "dados-demo": "tsx src/scripts/dados-demo.ts",
    "configurar-duplicati": "tsx src/scripts/configurar-duplicati.ts",
    "instalar-servico": "powershell -ExecutionPolicy Bypass -File src/scripts/instalar-servico.ps1",
    "remover-servico": "powershell -ExecutionPolicy Bypass -File src/scripts/instalar-servico.ps1 -Remover",
    "definir-senha": "tsx src/scripts/definir-senha.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
