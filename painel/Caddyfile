# ============================================================================
#  Painel Backup CH.Com - proxy HTTPS
#
#  O Node nao fala TLS e nao deve falar: quem lida com certificado, redirecao
#  e cabecalhos de seguranca e este proxy, e o painel fica so na rede interna
#  do Docker.
#
#  O Caddy pede o certificado ao Let's Encrypt sozinho na primeira subida e
#  renova sozinho antes de vencer. Nao ha cron para esquecer, nem certificado
#  vencendo num domingo.
#
#  PARA USAR: troque as duas linhas abaixo pelo seu dominio e seu e-mail.
#  O e-mail e so para o Let's Encrypt avisar se a renovacao falhar.
# ============================================================================

{
	email SEU-EMAIL@computerhome.com.br
}

painel.SEUDOMINIO.com.br {
	# O painel roda no container `painel`, na rede interna do compose.
	# Nenhuma porta dele fica aberta para a internet.
	reverse_proxy painel:3000

	# O painel monta as URLs dos cartorios a partir do host da requisicao.
	# Sem estes cabecalhos ele geraria "http://painel:3000/api/report/..."
	# na tela, e alguem colaria isso no Duplicati de um cartorio - que nunca
	# conseguiria entregar o relatorio.
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-Host {host}

	# HSTS: depois da primeira visita, o navegador se recusa a falar http com
	# este dominio. Importante porque o token do cartorio viaja em cada
	# relatorio; uma unica requisicao em texto aberto ja o entrega.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Registro de acesso, para saber quem bateu no painel e quando.
	log {
		output file /var/log/caddy/painel.log {
			roll_size 10mb
			roll_keep 10
		}
	}
}
