{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // strict liga um conjunto de verificacoes do TypeScript de uma vez.
    // Vale a pena mesmo em MVP: e o que faz o editor avisar quando um campo
    // do JSON do Duplicati pode vir vazio, em vez de o painel quebrar em
    // producao as tres da manha.
    "strict": true,
    "noUncheckedIndexedAccess": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
