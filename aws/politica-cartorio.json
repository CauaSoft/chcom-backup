{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarSomenteOPrefixoDesteCartorio",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::backup-aws-ch",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "CARTORIO/*",
            "CARTORIO"
          ]
        }
      }
    },
    {
      "Sid": "EscreverLerEDescongelarSomenteNoProprioPrefixo",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:RestoreObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::backup-aws-ch/CARTORIO/*"
    },
    {
      "Sid": "SaberEmQualRegiaoOBucketEsta",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::backup-aws-ch"
    }
  ]
}
