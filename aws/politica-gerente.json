{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LerOParqueInteiro",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::backup-aws-ch"
    },
    {
      "Sid": "BaixarEDescongelarQualquerCartorio",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:RestoreObject"
      ],
      "Resource": "arn:aws:s3:::backup-aws-ch/*"
    }
  ]
}
